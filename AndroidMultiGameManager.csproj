<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AndroidMultiGameManager</AssemblyName>
    <RootNamespace>AndroidMultiGameManager</RootNamespace>
      <Version>1.9.3</Version>
    <AssemblyVersion>1.9.3.0</AssemblyVersion>
    <FileVersion>1.9.3.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MaintenanceSmokeTest\**\*.cs" />
    <EmbeddedResource Remove="MaintenanceSmokeTest\**\*" />
    <None Remove="MaintenanceSmokeTest\**\*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="update-config.json" />
    <Content Include="update-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>